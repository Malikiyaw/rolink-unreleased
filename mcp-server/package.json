{
  "name": "rolink-mcp-server",
  "version": "2.1.1",
  "description": "RoLink MCP server - bridge between AI and Roblox Studio",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/mcp-server/src/index.js",
    "test": "vitest run && node ../rolink-extension/test-parser.js && node ../rolink-extension/test-agent.js",
    "test:parser": "node ../rolink-extension/test-parser.js",
    "test:agent": "node ../rolink-extension/test-agent.js",
    "generate:code-fields": "tsx ../scripts/generate-code-fields.ts",
    "generate:prompts": "tsx ../scripts/generate-tool-prompts.ts",
    "generate:fixtures": "tsx ../scripts/generate-tool-fixtures.ts",
    "audit:tools": "tsx ../scripts/generate-tool-audit.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "zod": "^3.23.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.13"
  }
}
